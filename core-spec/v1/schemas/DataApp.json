  "definitions" : {
    "metabase.data-apps.schema.allowed-host" : {
      "description" : "An origin a data app's sandboxed bundle may fetch: scheme, host with an optional `*.` subdomain wildcard, and an\n   optional port.",
      "type" : "string",
      "pattern" : "^https?://(\\*\\.)?[a-z0-9-]+(\\.[a-z0-9-]+)*(:\\d+)?$"
    },
    "metabase.data-apps.schema.description" : {
      "description" : "A data app's optional one-line summary, nil when blank.",
