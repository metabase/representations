      "additionalProperties" : false
    },
    "metabase.channel.schema.http-details" : {
      "description" : "The connection `:details` of a `:channel/http` channel.",
      "type" : "object",
      "properties" : {
        "fe-form-type" : {
          "type" : "string",
          "enum" : [ "api-key", "bearer", "basic", "none" ]
        },
        "url" : {
          "description" : "value must be a valid URL."
        },
        "auth-method" : {
          "type" : "string",
          "enum" : [ "none", "header", "query-param", "request-body" ]
        },
        "auth-info" : {
          "description" : "Value must be a map.",
          "anyOf" : [ {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          }, {
            "description" : "Value must be a map."
          } ]
        },
        "method" : {
          "type" : "string",
          "enum" : [ "get", "post", "put" ]
        }
      },
      "required" : [ "url", "auth-method" ],
      "additionalProperties" : false
    },
    "metabase.channel.schema.slack-details" : {
      "description" : "The connection `:details` of a `:channel/slack` channel.",
      "type" : "object",
      "properties" : {
        "channel" : {
          "type" : "string"
        }
      },
      "required" : [ "channel" ],
      "additionalProperties" : false
    },
    "metabase.channel.schema.test-details" : {
      "description" : "The `:details` of the test-only `:channel/metabase-test` channel, which exists so a test can drive a connection test\n  down each of its branches. `metabase.notification.test-util`'s `can-connect?` reads `:return-type` and then either\n  returns `:return-value` or throws with it as `ex-data`, so what `:return-value` may be depends on which:\n\n  - `\"return-value\"` -- the boolean `can-connect?` returns. `true` is the success branch (`{:ok true}`); `false` is\n    the failure one, echoed back as the 400's `{:connection-result false}`.\n  - `\"throw\"` -- the `ex-data` of the thrown exception, which the endpoint hands back as the 400's `:data`. The\n    field-keyed error map a connection check reports a bad detail with, as in `{:errors {:email \"Invalid email\"}}`.",
      "anyOf" : [ {
        "type" : "object",
        "properties" : { },
        "additionalProperties" : false
      }, {
        "type" : "object",
        "properties" : {
          "return-type" : {
            "const" : "return-value"
          },
          "return-value" : {
            "type" : "boolean"
          }
        },
        "required" : [ "return-type", "return-value" ],
        "additionalProperties" : false
      }, {
        "type" : "object",
        "properties" : {
          "return-type" : {
            "const" : "throw"
          },
          "return-value" : {
            "type" : "object",
            "properties" : {
              "errors" : {
                "type" : "object",
                "properties" : {
                  "email" : {
                    "type" : "string"
                  }
                },
                "additionalProperties" : false
              }
            },
            "required" : [ "errors" ],
            "additionalProperties" : false
          }
        },
        "required" : [ "return-type", "return-value" ],
        "additionalProperties" : false
      } ]
    }
  }
