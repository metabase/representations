{
  "name": "@metabase/representations",
  "version": "2.0.0",
  "description": "Zod schemas of Metabase representations, with portable or instance references",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/metabase/representations.git"
  },
  "homepage": "https://github.com/metabase/representations",
  "keywords": [
    "metabase",
    "representation",
    "serialization",
    "yaml",
    "schema",
    "validator"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint-eslint": "eslint --max-warnings 0 --report-unused-disable-directives scripts src",
    "lint-format": "oxfmt --check scripts src",
    "test": "bun test"
  },
  "dependencies": {
    "nanoid": "^5.1.9"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "glob": "^11.0.1",
    "js-yaml": "^4.1.0",
    "oxfmt": "^0.45.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "zod": "^4.4.2"
  }
}
